{
  "name": "raglab",
  "version": "0.1.0",
  "private": true,
  "description": "RAGLab \u2013 an open-source RAG workbench for developers",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @raglab/api --filter @raglab/web dev",
    "dev:api": "pnpm --filter @raglab/api dev",
    "dev:web": "pnpm --filter @raglab/web start",
    "build:mcp": "pnpm --filter @raglab/mcp build",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:integration": "pnpm --filter @raglab/api test:integration",
    "eval": "pnpm --filter @raglab/api eval",
    "lint": "pnpm -r lint && eslint scripts",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @raglab/api db:migrate",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "docs:links": "node scripts/check-links.mjs",
    "release:version": "node scripts/release-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
