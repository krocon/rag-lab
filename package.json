{
  "name": "raglab",
  "version": "0.1.0",
  "private": true,
  "description": "RAGLab – an open-source RAG workbench for developers",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @raglab/api --filter @raglab/web dev",
    "dev:api": "pnpm --filter @raglab/api dev",
    "dev:web": "pnpm --filter @raglab/web start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @raglab/api test:integration",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @raglab/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
