# RAGLab – example configuration. Copy to `.env` and adjust:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.

# ── PostgreSQL (used by docker-compose.yml) ──────────────────────────────────
POSTGRES_USER=raglab
POSTGRES_PASSWORD=raglab-local-dev-only
POSTGRES_DB=raglab
# Host port for the database container. Change it if 5432 is already in use.
POSTGRES_PORT=5432

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
# Comma-separated list of exact browser origins allowed to call the API ("*" is rejected).
# State-changing requests from other origins are refused (403 ORIGIN_NOT_ALLOWED).
CORS_ORIGINS=http://localhost:4200
# Host names the API answers to (protection against DNS rebinding); any port. Add your proxy's
# public name when running behind a reverse proxy. "*" disables the check (not recommended).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# RAGLab has NO authentication. Set to true only if another layer restricts access (reverse proxy
# with authentication, private container network). Otherwise the API warns at startup when
# API_HOST is not a loopback address. See docs/security.md.
NETWORK_ACCESS_PROTECTED=false
# Swagger UI and OpenAPI document under /api/docs (set to false if nobody needs them).
API_DOCS_ENABLED=true
# Maximum time in ms to receive a complete request incl. upload body (1000–3600000).
REQUEST_TIMEOUT_MS=120000

# ── Rate limits (per client IP, in memory) ───────────────────────────────────
# Exceeding a limit → 429 RATE_LIMITED with Retry-After.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
# Requests per window for all routes without a stricter limit.
RATE_LIMIT_MAX=300
# Stricter limits per window: uploads, chat, and retrieval/playground search (each route counts
# separately).
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_SEARCH_MAX=60
# Chat requests processed at the same time; more → 429 TOO_MANY_CONCURRENT_CHATS.
MAX_CONCURRENT_CHATS=4
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://raglab:raglab-local-dev-only@localhost:5432/raglab
DATABASE_POOL_MAX=10
# Optional, tests only: database for `pnpm test:integration`, which empties its domain tables.
# Unset: `<DATABASE_URL database>_test` on the same server (here raglab_test), created and migrated
# automatically. The name must contain "test" and must differ from DATABASE_URL – the tests refuse
# to run otherwise, so they never empty your development database.
# TEST_DATABASE_URL=postgresql://raglab:raglab-local-dev-only@localhost:5432/raglab_test

# ── AI providers ─────────────────────────────────────────────────────────────
# Ollama running natively on the host (recommended on macOS for GPU access).
OLLAMA_BASE_URL=http://localhost:11434
# Ollama as seen from the API container (docker compose --profile app). Default: the host's native
# Ollama via host.docker.internal; with the compose profile "ollama" use http://ollama:11434.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434

# Example models – RAGLab does not download any model for you.
#   ollama pull nomic-embed-text   (768 dimensions)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must equal the model's output dimension AND the vector column chunks.embedding, which migration
# 0001 creates as vector(768). Readiness (/api/health/ready) reports not_ready on a mismatch;
# another dimension needs a new migration and re-embedding (see docs/data-model.md). Max 2000.
EMBEDDING_DIMENSIONS=768
# Texts per embedding request (1–512) and timeout of one request in ms (1000–600000). The first
# request after starting Ollama also loads the model, so keep the timeout generous.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=60000

#   ollama pull llama3.2           (chat model for POST /api/chat)
CHAT_PROVIDER=ollama
CHAT_MODEL=llama3.2
# Maximum wait in ms for the next part of a streamed answer (1000–600000). It is an idle timeout,
# not a limit for the whole answer; the first request after starting Ollama also loads the model.
CHAT_TIMEOUT_MS=120000

# ── Pipeline defaults ────────────────────────────────────────────────────────
# Chunks returned by a search when the request has no topK (1–100).
RETRIEVAL_TOP_K=8
# Maximum length of a search query in characters after trimming (1–20000).
MAX_QUERY_CHARS=2000
# Maximum length of a chat question in characters after trimming; must be <= MAX_QUERY_CHARS
# (the question is the search query). Unset: min(2000, MAX_QUERY_CHARS).
MAX_QUESTION_CHARS=2000
# Characters of all <source> blocks in one chat prompt (1000–200000). Sources are added in rank
# order until the budget is used up; sources that do not fit are neither sent nor citable.
# Keep it well below the model's context window (≈ 4 characters per token).
CHAT_CONTEXT_CHAR_BUDGET=12000
# Maximum chunk size and overlap in characters (UTF-16 code units); CHUNK_OVERLAP < CHUNK_SIZE.
# Changes apply to newly processed documents only (no automatic re-chunking).
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ── Uploads & ingestion ──────────────────────────────────────────────────────
# Maximum size of one uploaded file in bytes (5 MiB; capped at 50 MiB). All files of a request are
# validated in memory, so a request holds up to MAX_UPLOAD_REQUEST_BYTES (see below).
MAX_UPLOAD_BYTES=5242880
# Maximum number of files per upload request (capped at 100).
MAX_UPLOAD_FILES=20
# Maximum total bytes of all files in one upload request (100 MiB; capped at 500 MiB; must be
# >= MAX_UPLOAD_BYTES). Keep nginx client_max_body_size (infra/docker/nginx.conf) above it.
MAX_UPLOAD_REQUEST_BYTES=104857600
# Optional maximum number of documents per collection; empty = unlimited.
MAX_DOCUMENTS_PER_COLLECTION=
# Documents processed in parallel by the in-process indexer (1–16). Kept low because chunking and
# embedding compete with chat requests for the same local model server.
INGESTION_CONCURRENCY=2

# ── MCP server (apps/mcp, stdio; see apps/mcp/README.md) ─────────────────────
# Read by the MCP server only (the MCP client usually sets them in its own config; variables set
# there win over this file). Base URL of the RAGLab API: http/https, no credentials or query. The
# host name must be in ALLOWED_HOSTS. The API has no authentication – keep it local.
RAGLAB_API_URL=http://127.0.0.1:3000
# Upper bound for the characters of one tool result (2000–200000); longer content is shortened.
MCP_MAX_OUTPUT_CHARS=20000
# Timeout of one API request in ms (1000–600000); above EMBEDDING_TIMEOUT_MS, since a search may
# have to load the embedding model.
MCP_REQUEST_TIMEOUT_MS=90000
# Timeout of a whole ask_knowledge call (retrieval + streamed answer) in ms (1000–1800000).
MCP_CHAT_TIMEOUT_MS=300000

# ── Docker Compose images (docs/release.md) ──────────────────────────────────
# Unset: images are built locally (raglab-api:local, …). To run released images instead, set e.g.
# RAGLAB_API_IMAGE=ghcr.io/<owner>/raglab-api:0.1.0 (same for web and mcp) and start with
# `docker compose --profile app up -d --no-build`.
# RAGLAB_API_IMAGE=
# RAGLAB_WEB_IMAGE=
# RAGLAB_MCP_IMAGE=
