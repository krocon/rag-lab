# RAGLab – example configuration. Copy to `.env` and adjust:  cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.

# ── PostgreSQL (used by docker-compose.yml) ──────────────────────────────────
POSTGRES_USER=raglab
POSTGRES_PASSWORD=raglab-local-dev-only
POSTGRES_DB=raglab
# Host port for the database container. Change it if 5432 is already in use.
POSTGRES_PORT=5432

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://raglab:raglab-local-dev-only@localhost:5432/raglab
DATABASE_POOL_MAX=10

# ── AI providers ─────────────────────────────────────────────────────────────
# Ollama running natively on the host (recommended on macOS for GPU access).
OLLAMA_BASE_URL=http://localhost:11434

# Example models – RAGLab does not download any model for you.
#   ollama pull nomic-embed-text   (768 dimensions)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must equal the model's output dimension AND the vector column in the database (max 2000).
EMBEDDING_DIMENSIONS=768

CHAT_PROVIDER=ollama
CHAT_MODEL=llama3.2

# ── Pipeline defaults ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=8
# Target chunk size and overlap in characters.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
