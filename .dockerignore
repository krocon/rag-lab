# Keep the build context small and free of secrets. Images copy only what they need (see
# infra/docker/*.Dockerfile); everything below never reaches a build.
**/node_modules
**/dist
**/.angular
**/coverage
**/*.tsbuildinfo
**/*.log
**/.DS_Store
.git
.github
.idea
.vscode
.claude
.env
.env.*
!.env.example
docs
prompts
eval/results
